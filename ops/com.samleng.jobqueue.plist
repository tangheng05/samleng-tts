<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts ops/jobqueue.sh at login and restarts it if it exits. Install:
     sed "s|HOME|$HOME|g" ops/com.samleng.jobqueue.plist > ~/Library/LaunchAgents/com.samleng.jobqueue.plist
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.samleng.jobqueue.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.samleng.jobqueue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>HOME/code/samleng-tts/ops/jobqueue.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME/samleng-jobs/runner.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/samleng-jobs/runner.log</string>
</dict>
</plist>
